# ╔═══════════════════════════════════════════════════════════════════════╗
# ║  Ticket to Ride — Environment Variables                              ║
# ║  Copy this file to .env and fill in real values.                     ║
# ║  The app will FAIL FAST at startup if required vars are missing.     ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# ─── REQUIRED ─────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ticket_to_ride

# JWT signing secret (min 32 characters — generate with: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production

# HMAC-SHA256 secret for ticket QR code signing (min 32 chars)
TICKET_SIGNING_SECRET=your-ticket-signing-secret-change-me

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Ticketmaster Discovery API key
# Get yours at: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=your-ticketmaster-api-key

# Stripe secret key (TEST MODE — starts with sk_test_)
# Get yours at: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Stripe webhook signing secret (starts with whsec_)
# Set up at: https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# ─── OPTIONAL (defaults shown) ───────────────────────────────────────────

# Port the API listens on
# PORT=3000

# Application environment
# NODE_ENV=development

# Frontend URL for CORS
# CORS_ORIGIN=http://localhost:5173

# TMDb API key (optional, for movie-based events)
# Get yours at: https://developer.themoviedb.org/
# TMDB_API_KEY=

# JWT token durations
# JWT_ACCESS_EXPIRY=15m
# JWT_REFRESH_EXPIRY=7d

# Reservation timeout in minutes (unpaid reservations expire after this)
# RESERVATION_TTL_MINUTES=10

# Sharing link expiry in hours
# SHARING_LINK_TTL_HOURS=48
