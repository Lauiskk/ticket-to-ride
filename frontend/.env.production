# Build de produção (Vite embute tudo isto no bundle — nada aqui é segredo).
#
# A chave PUBLICÁVEL da Stripe (VITE_STRIPE_PUBLISHABLE_KEY) NÃO está aqui de
# propósito: ela é definida nas variáveis de ambiente da Vercel, para ficar num
# lugar só junto das demais. Sem ela o checkout cai no modo simulado, que
# continua fechando o fluxo — só não conversa com a Stripe.

VITE_API_URL=https://ticket-to-ride-production-ebbe.up.railway.app
VITE_WS_URL=https://ticket-to-ride-production-ebbe.up.railway.app
