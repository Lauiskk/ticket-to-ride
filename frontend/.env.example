# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Copie para `.env` e preencha. Tudo aqui é EMBUTIDO no bundle e visível no
# navegador — nunca coloque segredo nenhum neste arquivo.

# API. Em dev deixe vazio para usar o proxy do Vite (/api → localhost:3000).
# VITE_API_URL=http://localhost:3000

# WebSocket de disponibilidade de assentos (namespace /seats).
VITE_WS_URL=http://localhost:3000

# Chave PUBLICÁVEL da Stripe (pk_test_...). É pública por definição — a chave
# secreta (sk_test_...) fica só no backend, em backend/.env.
# Pegue em: https://dashboard.stripe.com/test/apikeys
# Sem esta chave o checkout cai automaticamente no modo simulado.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
